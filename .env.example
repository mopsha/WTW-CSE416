EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 1 = run every screen against local fixtures (no backend; works in Expo Go). Default: real backend.
EXPO_PUBLIC_USE_MOCK=0
# Mock mode only: fraction (0-1) of API writes that fail, to try the retry UI.
EXPO_PUBLIC_MOCK_FAIL_RATE=0
